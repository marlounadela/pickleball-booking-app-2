<div class="pb-empty">
    <div class="pb-empty-icon"><i class="bi @Icon"></i></div>
    <div class="pb-empty-title">@Title</div>
    <div class="pb-empty-body">@Body</div>
    @if (ActionContent is not null)
    {
        <div class="mt-3">@ActionContent</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "bi-inbox";
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Body { get; set; } = "";
    [Parameter] public RenderFragment? ActionContent { get; set; }
}