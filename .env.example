# Copy to .env or set in Vercel project settings.
# NEVER commit real values.

# Production bootstrap (REQUIRED unless SEED_DEMO_DATA=true)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# Set true ONLY for staging/demo deployments (creates demo users with well-known passwords)
# SEED_DEMO_DATA=false

# Optional SQLite connection string override (e.g., persistent volume path)
# DATABASE_URL=DataSource=/tmp/app.db;Cache=Shared

# Tenant routing root (default: picklebook.com). For previews set to your *.vercel.app domain.
# AppSettings:RootDomain=picklebook.com

# Optional Data Protection key-ring directory (auth cookies/antiforgery survive restarts when persistent).
# Default: Data/keys next to the database file.
# DATA_PROTECTION_KEYS_PATH=/data/keys

# Optional real email (in-app notifications work without these)
# EmailSettings:Host=smtp.example.com
# EmailSettings:Port=587
# EmailSettings:Username=user@example.com
# EmailSettings:Password=secret
# EmailSettings:From=no-reply@picklebook.com